<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="R5a">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import R5a urdf file -->
    <xacro:include filename="$(find R5a)/urdf/R5a.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="R5a.ros2_control.xacro" />


    <xacro:R5a_ros2_control name="R5a_ros2_control" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
